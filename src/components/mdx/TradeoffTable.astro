---
interface Row {
  area: string;
  benefit: string;
  cost: string;
}

interface Props {
  rows: Row[];
}

const { rows } = Astro.props;
---

<div class="tradeoff-wrap">
  <table>
    <thead>
      <tr>
        <th>Area</th>
        <th>Benefit</th>
        <th>Cost</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          <td>{row.area}</td>
          <td>{row.benefit}</td>
          <td>{row.cost}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .tradeoff-wrap {
    overflow-x: auto;
    margin: 1.5rem 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  table {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
  }

  th,
  td {
    padding: 0.9rem 0.95rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  th:last-child,
  td:last-child {
    border-right: 0;
  }

  tbody tr:last-child td {
    border-bottom: 0;
  }

  th {
    background: var(--surface-strong);
    color: var(--text);
    font-size: 0.84rem;
    font-weight: 600;
  }

  td {
    color: var(--text-soft);
    line-height: 1.65;
  }
</style>
