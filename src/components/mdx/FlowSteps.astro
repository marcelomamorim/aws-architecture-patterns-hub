---
interface Step {
  title: string;
  description: string;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
---

<div class="flow-table">
  {steps.map((step, index) => (
    <article class="flow-row">
      <span class="flow-index">{String(index + 1).padStart(2, "0")}</span>
      <div class="flow-copy">
        <h3>{step.title}</h3>
        <p>{step.description}</p>
      </div>
    </article>
  ))}
</div>

<style>
  .flow-table {
    display: grid;
    gap: 0.75rem;
    margin: 1.5rem 0;
  }

  .flow-row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.85rem;
    align-items: start;
    padding: 0.95rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .flow-index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.2rem;
    height: 2.2rem;
    border-radius: 999px;
    background: rgba(var(--primary-rgb), 0.08);
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .flow-copy {
    display: grid;
    gap: 0.45rem;
  }

  .flow-copy h3,
  .flow-copy p {
    margin: 0;
  }

  .flow-copy h3 {
    font-size: 0.98rem;
    font-weight: 600;
  }

  .flow-copy p {
    color: var(--text-muted);
    line-height: 1.65;
  }

  @media (max-width: 640px) {
    .flow-row {
      grid-template-columns: 1fr;
    }
  }
</style>
