---
interface Item {
  title: string;
  difference: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<div class="comparison-grid">
  {items.map((item) => (
    <article>
      <h3>{item.title}</h3>
      <p>{item.difference}</p>
    </article>
  ))}
</div>

<style>
  .comparison-grid {
    display: grid;
    gap: 0.8rem;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    margin: 1.5rem 0;
  }

  .comparison-grid article {
    display: grid;
    gap: 0.5rem;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .comparison-grid h3,
  .comparison-grid p {
    margin: 0;
  }

  .comparison-grid h3 {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .comparison-grid p {
    color: var(--text-muted);
    line-height: 1.65;
  }
</style>
