---
interface Props {
  ids: string[];
}

const { ids } = Astro.props;
const joinedIds = ids.join(",");
---

<sup class="inline-citation" data-cite-ids={joinedIds} data-ready="false">
  [{ids.join(", ")}]
</sup>

<style>
  .inline-citation {
    display: inline-flex;
    gap: 0.12rem;
    margin-left: 0.18rem;
    font-size: 0.72em;
    line-height: 1;
    vertical-align: super;
    white-space: nowrap;
    font-family: var(--font-mono);
  }

  .inline-citation a,
  .inline-citation[data-ready="false"] {
    color: var(--primary);
  }

  .inline-citation a:hover {
    color: color-mix(in srgb, var(--primary) 84%, var(--text));
  }
</style>
