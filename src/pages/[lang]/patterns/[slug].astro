---
import { render } from "astro:content";
import AwsServiceList from "../../../components/AwsServiceList.astro";
import MediaAsset from "../../../components/MediaAsset.astro";
import AsciiDiagram from "../../../components/mdx/AsciiDiagram.astro";
import Bibliography from "../../../components/mdx/Bibliography.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { mdxComponents } from "../../../lib/mdx-components";
import { localizedPath } from "../../../lib/paths";
import { getPattern, getRelatedPatterns, getValidatedPatterns } from "../../../lib/patterns";
import {
  categoryLabels,
  complexityLabels,
  flowTypeLabels,
  getCopy,
  type Language
} from "../../../lib/site";

export async function getStaticPaths() {
  const patterns = await getValidatedPatterns();

  return patterns.map((pattern) => ({
    params: {
      lang: pattern.data.lang,
      slug: pattern.data.slug
    }
  }));
}

const lang = Astro.params.lang as Language;
const slug = Astro.params.slug!;
const pattern = await getPattern(lang, slug);

if (!pattern) {
  throw new Error(`Pattern not found: ${lang}/${slug}`);
}

const { Content } = await render(pattern);
const relatedPatterns = await getRelatedPatterns(lang, pattern.data.relatedPatterns);
const copy = getCopy(lang);
const currentPath = localizedPath(lang, `patterns/${slug}`);
const alternates = [
  { lang: "pt" as const, href: localizedPath("pt", `patterns/${slug}`) },
  { lang: "en" as const, href: localizedPath("en", `patterns/${slug}`) }
];
const bibliographyTitle = copy.bibliography;
const quickLinks = [
  { href: "#summary", label: lang === "pt" ? "Resumo" : "Summary" },
  { href: "#aws-services", label: copy.awsServices },
  { href: "#problem", label: copy.problemLabel },
  { href: "#solution", label: copy.solutionLabel },
  { href: "#use-cases", label: lang === "pt" ? "Aplicação" : "Use cases" },
  { href: "#article", label: lang === "pt" ? "Artigo" : "Article" },
  { href: "#related", label: copy.relatedPatterns }
];
const hasMedia = Boolean(
  pattern.data.media.animation?.src || pattern.data.media.diagram?.src || pattern.data.media.heroImage?.src
);
---

<BaseLayout
  lang={lang}
  title={pattern.data.title}
  description={pattern.data.summary}
  currentPath={currentPath}
  alternates={alternates}
>
  <section class="pattern-shell pattern-grid-bg">
    <div class="section-frame detail-shell">
      <div class="detail-main">
        <a class="back-link" href={localizedPath(lang, "patterns")}>{copy.backToCatalog}</a>

        <header class:list={["hero-block", { "no-media": !hasMedia }]}>
          <div class="hero-copy">
            <div class="hero-meta">
              <span class="eyebrow">{categoryLabels[lang][pattern.data.category]}</span>
              <span class="pill">{complexityLabels[lang][pattern.data.complexity]}</span>
              <span class="pill">{flowTypeLabels[lang][pattern.data.flowType]}</span>
            </div>

            <h1>{pattern.data.title}</h1>

            <div class="summary-box" id="summary">
              <p>{pattern.data.summary}</p>
            </div>
          </div>

          {hasMedia && (
            <div class="hero-media">
              <MediaAsset media={pattern.data.media} label={copy.mediaLabel} />
            </div>
          )}
        </header>

        <section class="service-band surface" id="aws-services">
          <div class="service-band-head">
            <div>
              <span class="detail-card-label">{copy.awsServices}</span>
              <h2>{lang === "pt" ? "Stack AWS mais comum neste padrão" : "Typical AWS stack for this pattern"}</h2>
            </div>
            <p>
              {lang === "pt"
                ? "Os serviços abaixo não são obrigatórios, mas representam combinações recorrentes para implementar esse desenho na AWS."
                : "The services below are not mandatory, but they represent common combinations to implement this design on AWS."}
            </p>
          </div>

          <AwsServiceList services={pattern.data.awsServices} size={48} variant="grid" lang={lang} linked={true} />
        </section>

        <div class="support-grid">
          <section class="detail-card" id="problem">
            <span class="detail-card-label">{copy.problemLabel}</span>
            <h2>{copy.problemLabel}</h2>
            <p>{pattern.data.problem}</p>
          </section>

          <section class="detail-card" id="solution">
            <span class="detail-card-label">{copy.solutionLabel}</span>
            <h2>{copy.solutionLabel}</h2>
            <p>{pattern.data.summary}</p>
          </section>
        </div>

        <section class="utility-grid" id="use-cases">
          <article class="utility-card">
            <span class="detail-card-label">{copy.whenToUse}</span>
            <ul>
              {pattern.data.whenToUse.map((item) => <li>{item}</li>)}
            </ul>
          </article>

          <article class="utility-card">
            <span class="detail-card-label">{copy.whenNotToUse}</span>
            <ul class="warning-list">
              {pattern.data.whenNotToUse.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        </section>

        <section class="aux-grid">
          <article class="ascii-card">
            <span class="detail-card-label">{lang === "pt" ? "Diagrama ASCII" : "ASCII diagram"}</span>
            <AsciiDiagram
              title={pattern.data.asciiDiagram.title}
              art={pattern.data.asciiDiagram.art}
              caption={pattern.data.asciiDiagram.caption}
            />
          </article>
        </section>

        <article class="article-card" id="article">
          <div class="prose">
            <Content components={mdxComponents} />
            <Bibliography title={bibliographyTitle} references={pattern.data.references} />
          </div>
        </article>

        {relatedPatterns.length > 0 && (
          <section class="related-card" id="related">
            <div class="related-head">
              <p class="eyebrow">{copy.relatedPatterns}</p>
              <p class="section-copy">
                {lang === "pt"
                  ? "Padrões próximos para comparação, composição ou aprofundamento."
                  : "Nearby patterns for comparison, composition, or deeper study."}
              </p>
            </div>

            <div class="related-links">
              {relatedPatterns.map((related) => (
                <a href={localizedPath(lang, `patterns/${related.data.slug}`)}>
                  <strong>{related.data.title}</strong>
                  <span>{related.data.summary}</span>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>

      <aside class="detail-rail surface">
        <div class="rail-group">
          <span class="detail-card-label">{copy.tocLabel}</span>
          <nav class="quick-nav">
            {quickLinks.map((item) => <a href={item.href}>{item.label}</a>)}
          </nav>
        </div>

        <div class="rail-group">
          <span class="detail-card-label">{lang === "pt" ? "Contexto" : "Context"}</span>
          <ul class="rail-list">
            <li>{pattern.data.references.length} {lang === "pt" ? "referências" : "references"}</li>
            <li>{pattern.data.relatedPatterns.length} {lang === "pt" ? "relacionados" : "related"}</li>
            <li>{pattern.data.awsServices.length} AWS {lang === "pt" ? "serviços" : "services"}</li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ references: pattern.data.references }}>
  (() => {
    const citations = Array.from(document.querySelectorAll(".inline-citation[data-cite-ids]"));

    if (citations.length === 0) {
      return;
    }

    const indexById = new Map(references.map((reference, index) => [reference.id, index + 1]));
    const labelById = new Map(
      references.map((reference) => {
        const primaryAuthor = reference.authors[0] ?? reference.publisher;
        const surname = primaryAuthor.split(/\s+/).at(-1) ?? primaryAuthor;
        return [reference.id, `${surname}, ${reference.year}`];
      })
    );

    for (const citation of citations) {
      const ids = (citation.dataset.citeIds ?? "")
        .split(",")
        .map((value) => value.trim())
        .filter(Boolean);

      const links = ids
        .map((id) => {
          const index = indexById.get(id);
          if (!index) {
            return "";
          }

          const label = labelById.get(id) ?? id;
          return `<a href="#ref-${id}" title="${label}">[${index}]</a>`;
        })
        .filter(Boolean)
        .join("");

      citation.innerHTML = links || citation.innerHTML;
      citation.dataset.ready = "true";
    }
  })();
</script>

<style>
  .pattern-shell {
    padding: 2.5rem 0 3.5rem;
  }

  .detail-shell {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: minmax(0, 1fr) 18.75rem;
    align-items: start;
  }

  .detail-main {
    display: grid;
    gap: 1.35rem;
    min-width: 0;
  }

  .back-link {
    color: var(--text-muted);
    font-size: 0.92rem;
    font-weight: 500;
  }

  .hero-block {
    display: grid;
    gap: 1.35rem;
    grid-template-columns: minmax(0, 1.2fr) minmax(20rem, 0.8fr);
    align-items: start;
  }

  .hero-block.no-media {
    grid-template-columns: 1fr;
  }

  .hero-copy,
  .hero-media {
    display: grid;
    gap: 1rem;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .hero-copy h1 {
    margin: 0;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 0.98;
    letter-spacing: -0.05em;
  }

  .summary-box,
  .service-band,
  .detail-card,
  .utility-card,
  .ascii-card,
  .article-card,
  .related-card {
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-soft);
  }

  .summary-box p,
  .detail-card p,
  .service-band-head p {
    margin: 0;
    color: var(--text-soft);
    line-height: 1.78;
  }

  .detail-card-label {
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .service-band {
    display: grid;
    gap: 1rem;
  }

  .service-band-head {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
  }

  .service-band-head > div {
    display: grid;
    gap: 0.55rem;
  }

  .service-band-head h2 {
    margin: 0;
    font-size: 1.08rem;
    font-weight: 600;
  }

  .service-band-head p {
    max-width: 40ch;
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .support-grid,
  .utility-grid,
  .aux-grid {
    display: grid;
    gap: 1rem;
  }

  .support-grid,
  .utility-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .aux-grid {
    grid-template-columns: 1fr;
  }

  .detail-card,
  .utility-card,
  .ascii-card {
    display: grid;
    gap: 0.9rem;
  }

  .detail-card h2,
  .utility-card ul {
    margin: 0;
  }

  .detail-card h2 {
    font-size: 1rem;
    font-weight: 600;
  }

  .utility-card ul {
    padding-left: 1.15rem;
    color: var(--text-soft);
    line-height: 1.72;
  }

  .warning-list li::marker {
    color: var(--danger);
  }

  .article-card {
    min-width: 0;
  }

  .related-card {
    display: grid;
    gap: 1rem;
  }

  .related-head {
    display: grid;
    gap: 0.75rem;
  }

  .related-links {
    display: grid;
    gap: 0.8rem;
  }

  .related-links a {
    display: grid;
    gap: 0.3rem;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface-alt);
  }

  .related-links strong {
    color: var(--text);
    font-size: 0.95rem;
    font-weight: 600;
  }

  .related-links span {
    color: var(--text-muted);
    line-height: 1.6;
  }

  .detail-rail {
    position: sticky;
    top: 5.5rem;
    display: grid;
    gap: 1rem;
    padding: 1rem;
  }

  .rail-group {
    display: grid;
    gap: 0.75rem;
  }

  .quick-nav {
    display: grid;
    gap: 0.45rem;
  }

  .quick-nav a {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .rail-list {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--text-muted);
    line-height: 1.7;
  }

  @media (max-width: 1160px) {
    .detail-shell {
      grid-template-columns: 1fr;
    }

    .detail-rail {
      position: static;
      order: -1;
    }
  }

  @media (max-width: 980px) {
    .hero-block,
    .support-grid,
    .utility-grid {
      grid-template-columns: 1fr;
    }

    .service-band-head {
      display: grid;
    }
  }
</style>
