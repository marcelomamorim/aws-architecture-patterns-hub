---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PatternCatalog from "../../../components/PatternCatalog.astro";
import {getCopy, type Language} from "../../../lib/site";
import {localizedPath} from "../../../lib/paths";
import {getPatternsByLanguage} from "../../../lib/patterns";

export async function getStaticPaths() {
    return [{params: {lang: "pt"}}, {params: {lang: "en"}}];
}

const lang = Astro.params.lang as Language;
const copy = getCopy(lang);
const patterns = await getPatternsByLanguage(lang);
const alternates = [
    {lang: "pt" as const, href: localizedPath("pt", "patterns")},
    {lang: "en" as const, href: localizedPath("en", "patterns")}
];
---

<BaseLayout
        lang={lang}
        title={copy.catalog}
        description={copy.catalogText}
        currentPath={localizedPath(lang, "patterns")}
        alternates={alternates}
>
    <PatternCatalog
            patterns={patterns}
            lang={lang}
            title={copy.catalogTitle}
            text={copy.catalogText}
    />
</BaseLayout>
